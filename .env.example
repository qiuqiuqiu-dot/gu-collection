# 环境变量示例
#
# ⚠️ 这个项目**不读取 .env 文件**（没有装 python-dotenv），
#    所以把本文件改名成 .env 是不会生效的。请用你启动进程的方式注入环境变量：
#      · Windows PowerShell：  $env:SECRET_KEY = "..."
#      · macOS / Linux：       export SECRET_KEY="..."
#      · systemd：             在 [Service] 里写 Environment="SECRET_KEY=..."
#      · 任务计划 / NSSM：     在动作或环境变量设置里填
#
# 下面除 SECRET_KEY 外都有默认值，按需取消注释。

# 必填。会话签名用，泄露等于任何人都能伪造登录态。
# 生成一串：python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# 数据库地址。相对路径会落在 instance/ 目录下；绝对路径要写成四个斜杠：
#   DATABASE_URL=sqlite:////srv/gu-data/gu.db
# DATABASE_URL=sqlite:///gu.db

# 监听地址。默认只绑本机；要让手机在同一个 WiFi 下访问就改成 0.0.0.0
# HOST=127.0.0.1

# PORT=5000

# 调试模式。默认 1（开着），对外提供服务时必须设成 0：
# 调试器暴露在公网上等于把服务器交给别人。
# FLASK_DEBUG=0

# 上传的图片放哪（默认 static/uploads）
# GU_UPLOAD_DIR=

# 自动备份放哪（默认 instance/backups，保留最近 14 份）
# GU_BACKUP_DIR=
